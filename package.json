{
  "name": "rumbai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RUMBAI — персональный AI-командный центр (PWA)",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-strip-types --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test 'server/*.test.ts' 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:pages": "tsc -b && VITE_CLOUD=off vite build --base=${PAGES_BASE:-/Rumbai/}"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wwgame28/Rumbai.git"
  }
}
